# ================= REQUIRED =================
# ---- MULTIPLE KEYS (rotation): when one key hits its limit the next one is used automatically ----
# Any provider accepts several keys: either a comma list  NAME_API_KEYS=k1,k2,k3  or  NAME_API_KEY, NAME_API_KEY_2 ... _9
# Gemini: use keys from DIFFERENT Google accounts / projects (keys of one project share one quota).
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
GEMINI_MODEL=gemini-3.5-flash-lite
MONGODB_URI=mongodb://127.0.0.1:27017/gita_reels
PORT=4000

# ================= VOICE =================
# FREE (used now): Gemini TTS - uses the same GEMINI_API_KEY above. Commercial use is allowed by Google's terms.
GEMINI_TTS_VOICE=Charon
VOICE_SPEED=1.0
# PAID options - leave EMPTY until you have the key. If a key is present it is used BEFORE Gemini.
# 1) Sarvam (best Hindi/Hinglish; free Rs.100 credit at signup, then ~Rs.2 per reel): dashboard.sarvam.ai
SARVAM_API_KEY=
# SARVAM_API_KEYS=key1,key2,key3
SARVAM_SPEAKER=shubh
# 2) ElevenLabs (paid plan needed for commercial use): elevenlabs.io -> API key + a voice id from your Voice Library
ELEVENLABS_API_KEY=
# ELEVENLABS_API_KEYS=key1,key2
ELEVENLABS_VOICE_ID=
# 3) Google Cloud Text-to-Speech Chirp 3 HD (needs billing account): console.cloud.google.com
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=hi-IN-Chirp3-HD-Charon
# order tried (providers without keys are skipped). edge-tts is NOT included on purpose (robotic, not monetization-safe)
TTS_PROVIDERS=sarvam,elevenlabs,google,gemini
# Narrator chants the Sanskrit shloka before explaining it
CHANT_SHLOK=true

# ================= VISUALS =================
# AI-generated images (animated in the video). Cloudflare = free ~230 images/day, no card:
# dash.cloudflare.com -> AI -> Workers AI -> Use REST API -> Create API token (copy Account ID too)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# More Cloudflare accounts (each has its own free daily limit): accountId:token pairs, comma separated
# CLOUDFLARE_ACCOUNTS=acc1:token1,acc2:token2,acc3:token3
# POLLINATIONS_KEYS=key1,key2
IMAGE_PROVIDERS=cloudflare,gemini,pollinations
# Optional fallbacks when AI images fail
PIXABAY_API_KEY=
PEXELS_API_KEY=
# PEXELS_API_KEYS=key1,key2

# ================= MUSIC =================
# auto = your files in assets/music, else generated spiritual ambience | synth | off
MUSIC_MODE=auto
MUSIC_VOLUME=0.22

# ================= PUBLISHING (optional; turn on in dashboard Settings) =================
# YouTube: console.cloud.google.com -> new project -> enable "YouTube Data API v3" -> OAuth client (Web application)
# Authorized redirect URI: http://localhost:4000/oauth/youtube/callback   then click "Connect YouTube" in Settings
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram Reels (professional account + Meta developer app with instagram_content_publish permission)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=graph.instagram.com   # only if your token is an Instagram-Login token

# ================= SPEED / CLEANUP =================
# Videos are made ONE AT A TIME (pause / resume from the dashboard). A stuck video is stopped after this many minutes:
JOB_TIMEOUT_MIN=40
JOB_TIMEOUT_MIN_LONG=150
# defaults to half of your CPU cores
# RENDER_CONCURRENCY=4
X264_PRESET=veryfast
# Storage: with CLEAN_MODE=retention (default) NOTHING is deleted at approve/render; ALL files of a reel (images, audio, clips, video)
# are deleted KEEP_HOURS after generation (only once it is posted/rejected/failed). Unposted approved/ready videos are kept up to KEEP_MAX_HOURS.
# The record (topic, script, post links) stays for the Calendar. Old behaviour: CLEAN_MODE=approve | render | never
CLEAN_MODE=retention
KEEP_HOURS=24
KEEP_MAX_HOURS=72

# ================= MISC (automation itself is switched in dashboard Settings) =================
CHANNEL_NAME=

# ================= SERVER / AWS =================
# Dashboard login (REQUIRED on a public server). Leave empty only on your own laptop.
DASHBOARD_USER=admin
DASHBOARD_PASS=change-this-long-password
# 127.0.0.1 = reachable only through nginx / SSH tunnel (keep this on AWS). Use 0.0.0.0 only inside Docker.
HOST=127.0.0.1
# Your https address (needed so YouTube "Connect" works on the server). Example: https://reels.yourdomain.com
PUBLIC_URL=https://reel.codwebx.in
# Google Search Console HTML-tag token (optional; only if you verify reel.codwebx.in with the HTML tag method)
GOOGLE_SITE_VERIFICATION=
# Hard cap: never plan or make more than this many videos per day
MAX_PER_DAY=4

# ================= SCRIPT QUALITY =================
# Optional: a stronger Gemini model used ONLY for writing scripts (leave empty = same as GEMINI_MODEL).
# Scripts are the most important part of a reel, so a bigger model here is the best upgrade.
GEMINI_SCRIPT_MODEL=

# ---- Rendering (low RAM friendly) ----
# Reels: browser tabs used in parallel (default = cpu cores / 3). Lower it if "ran out of memory" appears.
# RENDER_CONCURRENCY=2
# Long (5 min) video: 1 tab and 1280x720 by default. 1 = full HD 1920x1080 (needs 16 GB+ RAM)
# RENDER_CONCURRENCY_LONG=1
# LONG_RENDER_SCALE=0.6667   (the size is snapped to an even picture size automatically)
